---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PracticeHub from '../components/react/PracticeHub';
const qs = (await getCollection('practice')).map(({ data: d }) => ({ id: d.id, module: d.module, topic: d.topic, difficulty: d.difficulty, language: d.language, question: d.question, tags: d.tags }));
---
<Base title="Bookmarks" description="Questions you have starred.">
  <div style="max-width:60rem;margin:0 auto"><h1 style="margin-top:0">Bookmarks</h1><p class="muted">Star a question to find it here. Saved in this browser.</p><PracticeHub client:load questions={qs} only="bookmarks" /></div>
</Base>
