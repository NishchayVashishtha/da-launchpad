---
import { getCollection, render } from 'astro:content';
import Doc from '../../../layouts/Doc.astro';
import { mdxComponents } from '../../../components/mdx';
import { SHOW_DRAFTS } from '../../../lib/content';
export async function getStaticPaths() {
  const all = (await getCollection('cases')).filter((p) => SHOW_DRAFTS || !p.data.draft);
  return all.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content, headings } = await render(p);
const d = p.data;
---
<Doc title={d.title} description={`${d.industry} ${d.type}`} headings={headings}
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Business Thinking', href: '/business/' }, { label: d.title }]}
  meta={[d.industry, d.difficulty, d.type, `${d.estimatedMinutes} min`]}>
  <Content components={mdxComponents} />
</Doc>
