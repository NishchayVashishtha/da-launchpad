---
import Base from './Base.astro';
import { url } from '../lib/url';
interface Heading { depth: number; slug: string; text: string }
interface Props {
  title: string; description?: string;
  crumbs: { label: string; href?: string }[];
  headings?: Heading[];
  meta?: string[];
  prev?: { title: string; href: string } | null;
  next?: { title: string; href: string } | null;
  lessonId?: string;
}
const { title, description, crumbs, headings = [], meta = [], prev, next } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<Base title={title} description={description} sidebar>
  <div style="display:flex;gap:2rem;max-width:62rem;margin:0 auto" class="doc-wrap">
    <div style="flex:1;min-width:0">
      <nav aria-label="Breadcrumb" class="no-print" style="font-size:.85rem;margin-bottom:.75rem">
        <ol style="list-style:none;display:flex;flex-wrap:wrap;gap:.35rem;padding:0;margin:0" class="muted">
          {crumbs.map((c, i) => (
            <li>{c.href ? <a href={url(c.href)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}{i < crumbs.length - 1 && <span aria-hidden="true"> /</span>}</li>
          ))}
        </ol>
      </nav>
      <article data-pagefind-body class="prose">
        <h1 style="margin-bottom:.4rem">{title}</h1>
        {meta.length > 0 && <p class="no-print" style="display:flex;gap:.4rem;flex-wrap:wrap;margin-top:0">{meta.map((m) => <span class="chip">{m}</span>)}</p>}
        <slot />
      </article>
      <slot name="after" />
      {(prev || next) && (
        <nav aria-label="Lesson navigation" class="pager" style="display:flex;gap:1rem;justify-content:space-between;margin-top:1.5rem;flex-wrap:wrap">
          {prev ? <a class="btn" href={url(prev.href)} rel="prev">← {prev.title}</a> : <span />}
          {next ? <a class="btn btn-primary" href={url(next.href)} rel="next">{next.title} →</a> : <span />}
        </nav>
      )}
    </div>
    {toc.length > 0 && (
      <aside class="toc no-print" aria-label="On this page" style="display:none;width:14rem;flex:none">
        <div style="position:sticky;top:5rem;font-size:.82rem">
          <div style="font-weight:700;margin-bottom:.4rem">On this page</div>
          <ul style="list-style:none;padding:0;margin:0;border-left:1px solid var(--border)">
            {toc.map((h) => <li style={`padding-left:${h.depth === 3 ? 1.4 : .7}rem`}><a href={`#${h.slug}`} style="display:block;padding:.15rem 0;color:var(--muted);text-decoration:none">{h.text}</a></li>)}
          </ul>
        </div>
      </aside>
    )}
  </div>
</Base>
<style>
  @media (min-width: 1280px) { :global(.toc) { display: block !important; } }
</style>
