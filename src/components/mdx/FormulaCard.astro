---
interface Props { title: string }
const { title } = Astro.props;
---
<section class="card" style="margin:1.25rem 0;border-left:4px solid var(--brand)">
  <div class="callout-title" style="color:var(--brand);font-weight:700;font-size:.8rem;text-transform:uppercase;letter-spacing:.05em">Formula: {title}</div>
  <div class="formula" style="font-family:ui-monospace,Menlo,monospace;margin:.4rem 0"><slot /></div>
</section>
